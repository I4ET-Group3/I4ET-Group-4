        "head": "",
        "format": "<div>\n  <iframe \n    id=\"youtube-audio\" \n    style=\"width: 0; height: 0; border: none;\" \n    src=\"https://www.youtube.com/embed/czyGmRXJ184&ab_channel=Ambience?autoplay=1&playlist=czyGmRXJ184&ab_channel=Ambience&loop=1\" \n    frameborder=\"0\" \n    allow=\"autoplay\">\n  </iframe>\n  <button \n    id=\"stop-button\" \n    style=\"padding: 10px; background-color: red; color: white; font-weight: bold; margin-top: 10px;\">\n    Detener Alarma\n  </button>\n</div>\n\n<script>\n  (function(scope) {\n    scope.$watch('msg', function(msg) {\n      if (msg && msg.payload) {\n        let player = document.getElementById('youtube-audio');\n        player.src = `https://www.youtube.com/embed/czyGmRXJ184&ab_channel=Ambience?autoplay=1&playlist=czyGmRXJ184&ab_channel=Ambience&loop=1`; // Reemplaza abc123 con tu ID de video\n        player.style.width = \"0\"; // Ocultar el iframe visualmente\n        player.style.height = \"0\";\n        player.style.border = \"none\";\n      }\n    });\n\n    // Detener el sonido al presionar el botón\n    document.getElementById('stop-button').addEventListener('click', function() {\n      let player = document.getElementById('youtube-audio');\n      player.src = \"\"; // Detiene el sonido vaciando el iframe\n    });\n  })(scope);\n</script>\n    });\n  })(scope);\n</script>",
