    {
        "id": "e67e64affb4b94a9",
        "type": "function",
        "z": "505ce3c2469adeaa",
        "name": "function 1",
        "func": "// Find sensor values ​​by type\nconst tempSensor = msg.payload.event_data.payload.find(sensor => sensor.type === \"temp\");\nconst humSensor = msg.payload.event_data.payload.find(sensor => sensor.type === \"rel_hum\");\n\n// Create separate messages for each output\nconst tempMessage = { payload: tempSensor.value, unit: tempSensor.unit, timestamp: tempSensor.timestamp };\nconst humMessage = { payload: humSensor.value, unit: humSensor.unit, timestamp: humSensor.timestamp };\n\n// Send the temperature message to output 1 and the humidity message to output 2\nreturn [tempMessage, humMessage];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
